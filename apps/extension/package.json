{
  "name": "@lcs/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Chrome extension: collectors, side panel, options.",
  "scripts": {
    "dev": "node scripts/sync-catalog.mjs && wxt",
    "build": "node scripts/sync-catalog.mjs && wxt build",
    "test": "vitest run",
    "zip": "node scripts/sync-catalog.mjs && wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "node scripts/sync-catalog.mjs && wxt prepare && tsc --noEmit",
    "icons": "python3 scripts/build-icons.py"
  },
  "dependencies": {
    "@lcs/catalog": "workspace:*",
    "@lcs/core": "workspace:*",
    "@lcs/providers": "workspace:*",
    "@lcs/store": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
