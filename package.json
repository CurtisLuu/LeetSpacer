{
  "name": "leetspacer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spaced-repetition review scheduling over your own LeetCode and NeetCode history",
  "scripts": {
    "dev": "pnpm --filter @lcs/extension dev",
    "build": "pnpm -r --if-present build",
    "zip": "pnpm typecheck && pnpm test && pnpm --filter @lcs/extension zip",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "catalog:build": "pnpm --filter @lcs/catalog build:data",
    "neetcode:map": "pnpm --filter @lcs/catalog build:neetcode-map",
    "import:neetcode": "pnpm --filter @lcs/importers import:neetcode"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0"
}
